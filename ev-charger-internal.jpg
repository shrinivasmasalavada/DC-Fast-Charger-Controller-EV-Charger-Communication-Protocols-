  // --- service-worker + Cache-Storage purge (runs unconditionally) ---
  // Any leftover SW intercepts fetch before our Cache-Control headers are
  // evaluated, so it must be killed first. Runs async and fire-and-forget;
  // it doesn't need to finish before the build-id check below.
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.getRegistrations().then(function (regs) {
      regs.forEach(function (r) { r.unregister(); });
    });
  }
  if ('caches' in window) {
    caches.keys().then(function (keys) {
      keys.forEach(function (k) { caches.delete(k); });
    });
  }

  // --- pre-boot build-id check ---
  // BUILD_ID is replaced at build time by the NEXT_PUBLIC_BUILD_ID env var.
  var BUILD_ID = 'dpl_EaaEgcnpi5aX49JwUFHHZWA4T79W';
  // Guard key shared with BuildIdWatcher so they never both reload in the
  // same tab life. The pre-boot script writes it; BuildIdWatcher reads it.
  var GUARD_KEY = '__preBootReloaded';
  if (!BUILD_ID || sessionStorage.getItem(GUARD_KEY) === '1') return;

  var ctrl = new AbortController();
  // Abort the fetch after 1500ms — we must not delay first paint when the
  // network is slow; if the check can't complete in time we just proceed
  // normally (the downstream global-error boundary will still catch chunk
  // errors if they happen).
  var timer = setTimeout(function () { ctrl.abort(); }, 1500);

  fetch('/api/build-id', { cache: 'no-store', signal: ctrl.signal })
    .then(function (r) { return r.json(); })
    .then(function (d) {
      clearTimeout(timer);
      if (!d.buildId || d.buildId === BUILD_ID) return;
      // Stale HTML confirmed — mark guard FIRST so the page we reload into
      // doesn't re-enter this branch, then nuke the cache and reload.
      sessionStorage.setItem(GUARD_KEY, '1');
      // Best-effort purge request. The endpoint responds with Clear-Site-Data
      // which lets the browser wipe its HTTP cache in one atomic step.
      // We fire-and-forget (no await) so the reload doesn't wait on it.
      fetch('/api/purge-cache', { cache: 'no-store' }).catch(function () {});
      window.location.reload();
    })
    .catch(function () { clearTimeout(timer); });
})();</script><script src="/_next/static/chunks/a6dad97d9634a72d.js?dpl=dpl_EaaEgcnpi5aX49JwUFHHZWA4T79W" noModule=""></script></head><body class="source_serif_4_260dbf5a-module__dzLMAW__variable ibrand_3ed6e811-module__1uZhdW__variable antialiased"><div hidden=""><!--$--><!--/$--></div><script>((a,b,c,d,e,f,g,h)=>{let i=document.documentElement,j=["light","dark"];function k(b){var c;(Array.isArray(a)?a:[a]).forEach(a=>{let c="class"===a,d=c&&f?e.map(a=>f[a]||a):e;c?(i.classList.remove(...d),i.classList.add(f&&f[b]?f[b]:b)):i.setAttribute(a,b)}),c=b,h&&j.includes(c)&&(i.style.colorScheme=c)}if(d)k(d);else try{let a=localStorage.getItem(b)||c,d=g&&"system"===a?window.matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light":a;k(d)}catch(a){}})("class","theme","system",null,["light","dark"],null,true,true)</script><!--$--><!--/$--><section aria-label="Notifications alt+T" tabindex="-1" aria-live="polite" aria-relevant="additions text" aria-atomic="false"></section><div class="pointer-events-none fixed right-4 top-4 z-[60] flex justify-end"></div><!--$!--><template data-dgst="BAILOUT_TO_CLIENT_SIDE_RENDERING"></template><!--/$--><script src="/_next/static/chunks/2c66e47c940f34fd.js?dpl=dpl_EaaEgcnpi5aX49JwUFHHZWA4T79W" id="_R_" async=""></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,"1:\"$Sreact.fragment\"\n7:I[253348,[\"/_next/static/chunks/c8c8d18945d5e7d1.js?dpl=dpl_EaaEgcnpi5aX49JwUFHHZWA4T79W\"],\"default\"]\n:HL[\"/_next/static/chunks/17540d20d38f35d5.css?dpl=dpl_EaaEgcnpi5aX49JwUFHHZWA4T79W\",\"style\"]\n:HL[\"/_next/static/chunks/5498aebcb0dc7789.css?dpl=dpl_EaaEgcnpi5aX49JwUFHHZWA4T79W\",\"style\"]\n:HL[\"/_next/static/chunks/6d8b67a670bfafef.css?dpl=dpl_EaaEgcnpi5aX49JwUFHHZWA4T79W\",\"style\"]\n:HL[\"/_next/static/media/68d403cf9f2c68c5-s.p.fe21a1cd.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/ea3421846039b7f3-s.p.c02767a8.woff2\",\"font\",{\"crossOrigi